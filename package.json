{
  "name": "kevinten-cloudflare-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pages": "npm run check:articles && node scripts/prepare-pages-preview.mjs",
    "deploy:pages": "npm run build:pages -- --require-auth0 && wrangler pages deploy dist/pages --project-name kevinten-interactive-preview --branch preview",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "dev:worker": "wrangler dev --config worker/wrangler.toml --local",
    "next:dev": "npm --prefix next-portfolio run dev",
    "next:lint": "npm --prefix next-portfolio run lint",
    "next:build": "npm --prefix next-portfolio run build",
    "video:capture": "npm --prefix video run capture",
    "generate:articles": "node scripts/generate-articles-index.mjs",
    "check:articles": "node scripts/generate-articles-index.mjs --check",
    "provision:cloudflare": "node scripts/cloudflare-provision.mjs",
    "provision:auth0": "node scripts/auth0-provision.mjs",
    "provision:stripe": "node scripts/stripe-provision.mjs",
    "provision:access": "node scripts/cloudflare-access-provision.mjs",
    "provision:cutover": "node scripts/cloudflare-cutover-provision.mjs",
    "test": "vitest run worker/tests",
    "typecheck": "tsc --noEmit -p worker/tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build:pages && npm run verify:audits",
    "verify:next": "npm run next:lint && npm run next:build",
    "verify:all": "npm run verify && npm run verify:next",
    "verify:preview": "node scripts/verify-preview.mjs",
    "verify:cutover": "node scripts/verify-cutover-readiness.mjs",
    "verify:qrs": "node scripts/verify-reward-qrs.mjs",
    "verify:audits": "node scripts/verify-maintenance-audits.mjs"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "jose": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.9",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=20"
  }
}
